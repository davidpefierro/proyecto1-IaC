# {{ ansible_managed }}
<VirtualHost *:80>
    ServerName {{ servidor_nombre }}
    DocumentRoot {{ document_root }}

    <Directory {{ document_root }}>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    DirectoryIndex index.php index.html

    # Los .php los ejecuta PHP-FPM en la máquina php, por la red de datos
    <FilesMatch "\.php$">
        SetHandler "proxy:fcgi://{{ ip_datos_php }}:{{ php_fpm_puerto }}"
    </FilesMatch>

    # No servir el repositorio git
    <DirectoryMatch "/\.git">
        Require all denied
    </DirectoryMatch>

    ErrorLog ${APACHE_LOG_DIR}/guestbook_error.log
    CustomLog ${APACHE_LOG_DIR}/guestbook_access.log combined
</VirtualHost>
