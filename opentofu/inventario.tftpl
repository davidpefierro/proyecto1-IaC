# Generado por OpenTofu (opentofu/inventario.tf): no editar a mano
[servidores_balanceador]
balanceador ansible_host=${ip_balanceador} ansible_user=debian ip_datos=${ip_datos_balanceador}

[servidores_web]
%{ for w in webs ~}
${w.nombre} ansible_host=${w.ip_nat} ansible_user=debian ip_datos=${w.ip_datos}
%{ endfor ~}

[servidores_bd]
bd ansible_host=${ip_bd} ansible_user=ubuntu ip_datos=${ip_datos_bd}

[servidores_php]
php ansible_host=${ip_php} ansible_user=debian ip_datos=${ip_datos_php}

[servidores_nas]
nas ansible_host=${ip_nas} ansible_user=debian ip_datos=${ip_datos_nas}
